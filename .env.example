# 이 파일을 .env로 복사해서 값을 채운다. .env는 Git에 올리지 않는다.
DB_URL=jdbc:postgresql://localhost:5432/togather
DB_USERNAME=
DB_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GEMINI_API_KEY=
TOGATHER_TOKEN_KEY=

# 선택 항목
APP_URL=http://localhost:5173
# true면 Google 없이 이메일로 로그인하는 개발용 로그인 사용 (로컬 전용)
DEV_LOGIN_ENABLED=true
# Gemini 모델을 바꿀 때만 (기본: gemini-2.5-flash, gemini-embedding-001)
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
