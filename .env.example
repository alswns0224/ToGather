# 이 파일을 .env로 복사해서 값을 채운다. .env는 Git에 올리지 않는다.
DB_URL=jdbc:postgresql://localhost:5432/togather
DB_USERNAME=
DB_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Notion 실시간 반영(웹훅)용. 구독을 만들면 서버 로그에 찍히는 verification_token을 넣는다. 없으면 5분마다 동기화
NOTION_WEBHOOK_TOKEN=
GEMINI_API_KEY=
TOGATHER_TOKEN_KEY=

# 선택 항목
APP_URL=http://localhost:5173
# true면 Google 없이 이메일로 로그인하는 개발용 로그인 사용 (로컬 전용)
DEV_LOGIN_ENABLED=true
# Gemini 모델을 바꿀 때만 (기본: gemini-3.5-flash, gemini-embedding-001)
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
# true면 Slack 스레드를 10분마다 자동으로 논의 분석한다 (Gemini 사용량이 늘어난다). 기본 false
ANALYSIS_AUTO_ENABLED=
# 통합 검색: BGE-M3(Ollama) + Chroma. 기본값이면 비워 둔다. Ollama·Chroma가 없으면 SEARCH_ENABLED=false
SEARCH_ENABLED=
OLLAMA_URL=
EMBEDDING_MODEL=
CHROMA_URL=
